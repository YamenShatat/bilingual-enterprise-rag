# Copy to .env and set your own password. .env is ignored by Git; never commit it.
#
# These names are read by both docker-compose.yml and the Python code
# (bilingual_rag.config). Only POSTGRES_PASSWORD is required.
#
# Use a password of letters and digits: the same file is read by Docker Compose and by a
# small parser in bilingual_rag.config, which treat quotes and "#" differently.

POSTGRES_PASSWORD=change-me-before-first-start

# Optional; the values below are the defaults.
POSTGRES_USER=rag
POSTGRES_DB=rag
# 127.0.0.1 rather than localhost: the container publishes on IPv4 loopback only.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
